# Produção. Copie para `.env.production` e preencha — a API recusa subir com o que
# sobrou de desenvolvimento aqui dentro.

YARD_DOMAIN=yard.suaplanta.com.br
ACME_EMAIL=ti@suaplanta.com.br

# Banco (sem credencial padrão: a API checa e reclama)
POSTGRES_USER=yard_prod
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=yard

# Identidade
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=troque-esta-senha

# Planta
YARD_PLANT_CODE=PLANT-01
YARD_PLANT_TIMEZONE=America/Sao_Paulo

# Campo (OT) — pelo menos um dos dois é obrigatório no modo live
YARD_MQTT_HOST=mqtt.planta.local
YARD_MQTT_PORT=8883
YARD_MQTT_USERNAME=yard
YARD_MQTT_PASSWORD=troque-esta-senha
YARD_MQTT_GROUP_ID=GPLANSIS
YARD_OPCUA_ENDPOINT=opc.tcp://clp.planta.local:4840
YARD_OPCUA_USERNAME=yard
YARD_OPCUA_PASSWORD=troque-esta-senha
